# Copy to .env and replace the example domains. Never put credentials here.
MSX_PUBLIC_URL=https://tv.example.com
JELLYFIN_URL=https://jellyfin.example.com
MSX_ALLOW_HTTP=false
# Optional network budget in bits/s. Empty means no operator limit; not a TV codec limit.
MSX_MAX_BITRATE=
MSX_ALLOW_TRANSCODING=false
# Experimental backend-only WebVTT resources; normal MSX UI remains Off.
MSX_ENABLE_SUBTITLE_RESOURCES=false
# Experimental backend-only persistence; both must be supplied to opt in.
# Absolute SQLite path in a private directory; provision the external Fernet key
# through the runtime secret store. Never paste the key into this example file.
MSX_AUTHORIZATION_DB=
MSX_AUTHORIZATION_KEY=
MSX_AUTHORIZATION_TTL=2592000
# Opt-in official-web MSX storage client; requires the database and key above.
MSX_REMEMBER_DEVICES=false
# Public DNS name pointing to this host, used by Caddy for HTTPS.
MSX_DOMAIN=tv.example.com
